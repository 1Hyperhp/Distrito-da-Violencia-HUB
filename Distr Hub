local enabled = {killer=false,survivor=false,generator=false}
local colors = {killer=Color3.fromRGB(255,65,65),survivor=Color3.fromRGB(165,85,255),generator=Color3.fromRGB(255,255,255)}
local marks = {}
local generators = {}
local completedGenerators = {}

local function clearMark(inst)
    local h = marks[inst]
    if h then h:Destroy(); marks[inst] = nil end
end
local function mark(inst,kind)
    if not inst or not inst:IsDescendantOf(workspace) or not enabled[kind] then
        clearMark(inst)
        return
    end
    local h = marks[inst]
    if not h then
        h = Instance.new('Highlight')
        h.Name = 'VD_ESP_Marker'
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.FillTransparency = .72
        h.OutlineTransparency = 0
        h.Adornee = inst
        h.Parent = gui
        marks[inst] = h
    end
    local color = (kind == 'generator' and completedGenerators[inst]) and Color3.fromRGB(55,235,100) or colors[kind]
    h.FillColor = color
    h.OutlineColor = color
end
local function role(player)
    local teamName = player.Team and player.Team.Name:lower() or ''
    if KILLER_TEAMS[teamName] then return 'killer' end
    if SURVIVOR_TEAMS[teamName] then return 'survivor' end
    return nil
end
local function refreshPlayers()
    local wanted = {}
    for _,player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local r = role(player)
            if r and enabled[r] then
                wanted[player.Character] = r
            end
        end
    end
    for inst,h in pairs(marks) do
        if not generators[inst] and not wanted[inst] then
            clearMark(inst)
        end
    end
    for inst,kind in pairs(wanted) do mark(inst,kind) end
end
-- Detecta candidatos por nome, atributos ou prompts de reparo.
-- Um modelo proximo do prompt e usado como alvo, evitando marcar a peca isolada.
local function genHint(name)
    local n = name:lower()
    return n:find('generator',1,true) or n:find('gerador',1,true)
        or n:find('repair',1,true) or n:find('engine',1,true)
end
local function hasRepairPrompt(obj)
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA('ProximityPrompt') then
            local phrase = (d.Name..' '..d.ActionText..' '..d.ObjectText):lower()
            if phrase:find('repair',1,true) or phrase:find('repar',1,true)
                or phrase:find('generator',1,true) or phrase:find('gerador',1,true) then
                return true
            end
        end
    end
    return false
end
local function isGenerator(obj)
    if not (obj:IsA('Model') or obj:IsA('BasePart')) then return false end
    if not obj:IsDescendantOf(workspace) then return false end
    local hint = genHint(obj.Name) or (obj:IsA('Model') and hasRepairPrompt(obj))
    if not hint then return false end
    -- Prefere o modelo inteiro, quando o nome do pai identifica o mesmo gerador.
    local parent = obj.Parent
    if parent and (parent:IsA('Model') or parent:IsA('BasePart')) and genHint(parent.Name) then
        return false
    end
    return true
end
-- Le indicadores explicitos de conclusao sem presumir que um prompt desativado
-- significa gerador concluido (pode estar fora de alcance ou bloqueado).
local completionNames = {
    completed=true, complete=true, finished=true, repaired=true,
    iscompleted=true, iscomplete=true, isrepaired=true,
    concluido=true, concluida=true, reparado=true, reparada=true,
    fullyrepaired=true,
}
-- Conservador: valores genericos de progresso (0..1) nao provam conclusao.
-- Aceita apenas sinalizadores explicitos no proprio gerador e em filhos diretos.
local function completedFlag(name, value)
    local normalized = tostring(name):lower():gsub('[^%a]', '')
    if not completionNames[normalized] then return false end
    return value == true or value == 1 or value == 'true'
end
local function checkCompletionNode(node)
    for name, value in pairs(node:GetAttributes()) do
        if completedFlag(name, value) then return true end
    end
    for _, child in ipairs(node:GetChildren()) do
        if (child:IsA('BoolValue') or child:IsA('IntValue') or child:IsA('NumberValue'))
            and completedFlag(child.Name, child.Value) then
            return true
        end
    end
    return false
end
local function isCompletedGenerator(obj)
    if checkCompletionNode(obj) then return true end
    -- Apenas filhos diretos relevantes: evita confundir progresso de pecas,
    -- objetivos secundarios ou outros geradores agrupados.
    for _, child in ipairs(obj:GetChildren()) do
        if child:IsA('Model') or child:IsA('Folder') then
            local name = child.Name:lower()
            if name:find('status',1,true) or name:find('state',1,true)
                or name:find('repair',1,true) or name:find('progress',1,true) then
                if checkCompletionNode(child) then return true end
            end
        end
    end
    return false
end

local function registerGenerator(obj)
    if generators[obj] then return end
    if isGenerator(obj) then
        generators[obj] = true
        completedGenerators[obj] = isCompletedGenerator(obj)
        if enabled.generator then mark(obj,'generator') end
    end
end
local function rescanGeneratorMap()
    -- Uma varredura por ciclo, evitando dois GetDescendants completos.
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA('Model') or obj:IsA('BasePart')) and genHint(obj.Name) then
            registerGenerator(obj)
        elseif obj:IsA('ProximityPrompt') then
            local phrase = (obj.Name..' '..obj.ActionText..' '..obj.ObjectText):lower()
            if phrase:find('repair',1,true) or phrase:find('repar',1,true) then
                local parent = obj.Parent
                for _ = 1, 4 do
                    if not parent or parent == workspace then break end
                    if parent:IsA('Model') then registerGenerator(parent); break end
                    parent = parent.Parent
                end
            end
        end
    end
end

local function refreshGenerators()
    for inst in pairs(generators) do
        if not inst:IsDescendantOf(workspace) then
            generators[inst] = nil
            completedGenerators[inst] = nil
            clearMark(inst)
        elseif enabled.generator then
            completedGenerators[inst] = isCompletedGenerator(inst)
            mark(inst,'generator')
        else
            clearMark(inst)
        end
    end
end
rescanGeneratorMap()
