local function angleError(a,b)
    return (a-b+180)%360-180
end
local function findCheck()
    local promptGui = playerGui:FindFirstChild('SkillCheckPromptGui')
    if not promptGui or not promptGui.Enabled then return nil end
    local check = promptGui:FindFirstChild('Check')
    if not check or not check:IsA('GuiObject') or not check.Visible then return nil end
    local goal = check:FindFirstChild('Goal')
    local line = check:FindFirstChild('Line')
    if not goal or not line or not goal:IsA('GuiObject') or not line:IsA('GuiObject') then return nil end
    if not goal.Visible or not line.Visible then return nil end
    return check,goal,line
end
local function pressSpace()
    if not vimOK or not VIM then return false end
    local ok = pcall(function()
        keyHeld = true
        VIM:SendKeyEvent(true,Enum.KeyCode.Space,false,game)
        task.delay(0.035,function()
            pcall(function() VIM:SendKeyEvent(false,Enum.KeyCode.Space,false,game) end)
            keyHeld = false
        end)
    end)
    return ok
end
listen(RunService.RenderStepped,function()
    if not autoRequested then return end
    local check,goal,line = findCheck()
    if not check then
        resetCheck()
        note.Text = 'Aguardando circulo de reparo...'
        return
    end
    if currentCheck ~= check then
        currentCheck = check
        previousError,previousGoal,triggered = nil,nil,false
    end
    local target = (goal.Rotation+112)%360
    local errorNow = angleError(line.Rotation,target)
    if previousGoal ~= nil and math.abs(angleError(goal.Rotation,previousGoal))>5 then
        previousError = nil
    end
    previousGoal = goal.Rotation
    local closeEnough = math.abs(errorNow)<=2
    local crossed = false
    if previousError ~= nil then
        local movement = angleError(errorNow,previousError)
        if math.abs(previousError)<=8 and math.abs(errorNow)<=8 and math.abs(movement)<=16 then
            crossed = (previousError<0 and errorNow>=0) or (previousError>0 and errorNow<=0)
        end
    end
    previousError = errorNow
    if triggered then
        note.Text = 'Espaco acionado. Aguardando proxima rodada...'
        return
    end
    note.Text = string.format('Acompanhando faixa branca.\nDistancia: %.1f graus',math.abs(errorNow))
    if closeEnough or crossed then
        triggered = true
        local ok = pressSpace()
        note.Text = ok and 'Espaco acionado! Aguardando proxima rodada...' or 'Falha ao enviar Espaco.'
        print('[VD HUB V19] Auto gerador', 'Goal:',goal.Rotation,'Line:',line.Rotation,'Erro:',errorNow)
    end
end)
