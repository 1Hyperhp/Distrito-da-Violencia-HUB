local function getHumanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass('Humanoid')
end
local function writeSpeed(base)
    local hum = speedHumanoid
    if not speedEnabled or not hum or not hum.Parent or not base then return end
    if base < 0 or base > 100 then return end
    local target = base * multiplier
    if math.abs(hum.WalkSpeed-target) < .03 then return end
    ownWrite = true
    hum.WalkSpeed = target
    lastApplied = target
    ownWrite = false
end
local function detachSpeed()
    if speedConnection then speedConnection:Disconnect(); speedConnection=nil end
    speedHumanoid = nil
end
local function attachSpeed(hum)
    if speedHumanoid == hum then return end
    detachSpeed()
    lastBase, lastApplied = nil, nil
    speedHumanoid = hum
    if not hum then return end
    lastBase = hum.WalkSpeed
    speedConnection = hum:GetPropertyChangedSignal('WalkSpeed'):Connect(function()
        if ownWrite or not speedHumanoid or not speedHumanoid.Parent then return end
        local current = speedHumanoid.WalkSpeed
        if lastApplied and math.abs(current-lastApplied) < .03 then return end
        lastBase = current
        if speedEnabled then writeSpeed(current) end
    end)
    if speedEnabled then writeSpeed(lastBase) end
end
local function restoreSpeed()
    speedEnabled = false
    if speedHumanoid and speedHumanoid.Parent and lastBase then
        ownWrite = true
        speedHumanoid.WalkSpeed = lastBase
        ownWrite = false
    end
    lastApplied = nil
end
local function updateSpeedUI()
    speedButton.Text = 'Speed Boost [' .. (speedEnabled and 'ON' or 'OFF') .. ']'
    speedText.Text = string.format('Multiplicador: %.2fx',multiplier)
    local fraction = (multiplier-speedMin)/(speedMax-speedMin)
    fill.Size = UDim2.fromScale(fraction,1)
    knob.Position = UDim2.fromScale(fraction,.5)
end
listen(speedButton.MouseButton1Click,function()
    if speedEnabled then
        restoreSpeed()
        speedNote.Text = 'Boost desligado.'
    else
        -- Captura a velocidade-base atual, como no V32.
        attachSpeed(getHumanoid())
        speedEnabled = true
        if speedHumanoid then
            lastBase = speedHumanoid.WalkSpeed
            writeSpeed(lastBase)
        end
        speedNote.Text = 'Multiplicador dinamico ativo.'
    end
    updateSpeedUI()
end)
local draggingSpeed = false
local function setSpeedFromX(x)
    local width = track.AbsoluteSize.X
    if width <= 0 then return end
    local fraction = math.clamp((x-track.AbsolutePosition.X)/width,0,1)
    multiplier = math.floor((speedMin+fraction*(speedMax-speedMin))*100+.5)/100
    updateSpeedUI()
    if speedEnabled then writeSpeed(lastBase) end
end
