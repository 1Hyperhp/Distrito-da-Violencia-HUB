listen(workspace.DescendantAdded,function(obj)
    if (obj:IsA('Model') or obj:IsA('BasePart')) and genHint(obj.Name) then
        registerGenerator(obj)
    elseif obj:IsA('ProximityPrompt') then
        task.defer(function()
            if not gui.Parent then return end
            local ancestor = obj.Parent
            for _ = 1, 5 do
                if not ancestor or ancestor == workspace then break end
                if ancestor:IsA('Model') then registerGenerator(ancestor) end
                ancestor = ancestor.Parent
            end
        end)
    end
end)
