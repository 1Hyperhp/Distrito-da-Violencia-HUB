local function getHumanoid()
    local char = LocalPlayer.Character
    return char and char:FindFirstChildOfClass('Humanoid')
end
local function applySpeed()
    local hum = getHumanoid()
    if not hum then return end
    if originalSpeeds[hum] == nil then
        originalSpeeds[hum] = hum.WalkSpeed
    end
    hum.WalkSpeed = speedValue
end
local function restoreSpeed()
    for hum, old in pairs(originalSpeeds) do
        if hum and hum.Parent then
            pcall(function() hum.WalkSpeed = old end)
        end
        originalSpeeds[hum] = nil
    end
end
local function updateSpeedUI()
    speedButton.Text = 'Velocidade [' .. (speedEnabled and 'ON' or 'OFF') .. ']'
    speedText.Text = 'Velocidade: ' .. speedValue
    local fraction = (speedValue-speedMin)/(speedMax-speedMin)
    fill.Size = UDim2.fromScale(fraction,1)
    knob.Position = UDim2.fromScale(fraction,.5)
end
