    if width <= 0 then return end
    local fraction = math.clamp((x-track.AbsolutePosition.X)/width,0,1)
    speedValue = math.floor(speedMin+fraction*(speedMax-speedMin)+.5)
    updateSpeedUI()
    if speedEnabled then applySpeed() end
end
